# Variáveis de ambiente do Acelerador RM -- MODELO.
# Copie para .env (ignorado pelo Git) para uso local, ou cadastre cada uma em
# Vercel > Settings > Environment Variables. NUNCA coloque valores reais aqui.

# --- Banco (obrigatória em produção) ---------------------------------------
# Use a URL "pooled" do Neon (host com "-pooler"). Sem ela, o app usa um
# SQLite local/temporário que NÃO persiste na Vercel.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require

# --- Segurança da API (opcionais; desligadas se ausentes) --------------------
# Chaves de API por cliente, no formato "chave:codigo_do_cliente", separadas por vírgula.
# Gere chaves longas e aleatórias (ex.: 32+ caracteres).
# API_KEYS=troque-esta-chave-1:clienteA,troque-esta-chave-2:clienteB
#
# 1 = recusa (401) chamadas sem chave válida. Ligue só quando TODOS os clientes
# da API (inclusive o Google Sheets) já tiverem chave. A tela web do próprio app
# NÃO envia chave: com isto ligado, ela precisa de login/proxy antes (ver docs).
# API_EXIGIR_CHAVE=1
#
# Limite de chamadas por minuto, por cliente+IP (0 ou ausente = sem limite).
# Aproximado na Vercel (cada instância conta separado).
# RATE_LIMIT_POR_MINUTO=120
